{
  "name": "website-analyzer",
  "version": "1.0.0",
  "description": "Open-core Website Analyzer SaaS — SEO, Performance, Security, Accessibility & more",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "analyze": "node packages/cli/bin/index.js",
    "test": "node tests/index.js",
    "build": "echo 'No build step yet'",
    "lint": "echo 'No linter yet'",
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev --workspace=apps/api\" \"cd apps/web && npm run dev\""
  },
  "license": "MIT",
  "keywords": [
    "seo",
    "performance",
    "security",
    "accessibility",
    "website-analyzer",
    "cli",
    "saas"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
